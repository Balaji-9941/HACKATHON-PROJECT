{
  "name": "paytelemetry-backend",
  "version": "1.0.0",
  "description": "PayTelemetry Backend - Real-Time Payments Fraud Detection Platform",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test tests/**/*.test.js",
    "seed": "node seed.js",
    "seed:demo": "node -e \"require('./services/dataIngestion').seedDemoFallback()\"",
    "ingest:paysim": "node -e \"require('./services/dataIngestion').ingestPaySim()\"",
    "ingest:ulb": "node -e \"require('./services/dataIngestion').ingestULB()\"",
    "ingest:ieee": "node -e \"require('./services/dataIngestion').ingestIEEE()\""
  },
  "dependencies": {
    "axios": "^1.6.8",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "csv-parser": "^3.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mathjs": "^12.4.1",
    "mongoose": "^8.3.1",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "socket.io-client": "^4.8.3"
  }
}
